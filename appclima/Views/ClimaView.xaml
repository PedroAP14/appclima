<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appclima.Views.ClimaView"
             Title="ClimaView">
    <VerticalStackLayout>

        <Image
            x:Name="CondicaoImage"
            Source="dotnet_bot.png"
            WidthRequest="40"
        />

        <Label 
            x:Name="CondicaoTextoLabel" 
            Text="Teste"/>

        <HorizontalStackLayout>

            <Label Text="Minima"/>

            <Label Text="Maxima"/>

        </HorizontalStackLayout>

        <HorizontalStackLayout>

            <Label 
                x:Name="TemperaturaMininaLabel"
                Text="0 Graus" />

            <Label 
                x:Name="TemperaturaMaximaLabel"
                Text="99 Graus" />

        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>